<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/background"
    tools:context=".activity.SignInActivity">

    <carbon.widget.ImageView
        android:id="@+id/logoImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="30dp"
        android:background="@color/white"
        android:src="@drawable/holsale_app_logo"
        app:carbon_cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <carbon.widget.ImageView
        android:id="@+id/welcomeImg"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:src="@drawable/welcome"
        app:layout_constraintEnd_toEndOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="@id/logoImage"
        app:layout_constraintTop_toBottomOf="@id/logoImage" />

    <carbon.widget.TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:lineHeight="32dp"
        android:text="Hey there!\nClick Below To Continue"
        android:textAlignment="center"
        android:textColor="@color/colorPrimaryVariant"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcomeImg" />

    <carbon.widget.RelativeLayout
        android:id="@+id/googleBtn"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="35dp"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:carbon_cornerRadius="14dp"
        app:carbon_rippleColor="@color/colorPrimaryVariant"
        app:carbon_rippleStyle="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <carbon.widget.ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_google" />

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/leaguespartan_variablefont_wght"
            android:text="Sign In With Google"
            android:textColor="@color/background"
            android:textSize="24sp"
            android:textStyle="bold" />

    </carbon.widget.RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>