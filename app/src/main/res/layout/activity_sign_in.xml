<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activity.SignInActivity">

    <carbon.widget.ImageView
        android:id="@+id/logoImage"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/holsale_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <carbon.widget.TextView
        android:id="@+id/signInTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/overlockregular"
        android:text="Sign In"
        android:textColor="@color/colorPrimary"
        android:textSize="72sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="@id/logoImage"
        app:layout_constraintTop_toBottomOf="@id/logoImage" />

    <carbon.widget.ImageView
        android:id="@+id/welcomeImg"
        android:layout_width="match_parent"
        android:layout_height="370dp"
        android:src="@drawable/welcome"
        app:layout_constraintEnd_toEndOf="@id/signInTxt"
        app:layout_constraintStart_toStartOf="@id/signInTxt"
        app:layout_constraintTop_toBottomOf="@id/signInTxt" />

    <carbon.widget.TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:lineHeight="32dp"
        android:text="Hey there,\nWelcome to Holsale!!"
        android:textAlignment="center"
        android:textColor="@color/colorPrimaryVariant"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/signInTxt"
        app:layout_constraintStart_toStartOf="@id/signInTxt"
        app:layout_constraintTop_toBottomOf="@id/welcomeImg" />

    <carbon.widget.RelativeLayout
        android:id="@+id/googleBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:carbon_cornerRadius="24dp"
        app:carbon_rippleColor="@color/colorPrimaryVariant"
        app:carbon_rippleStyle="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <carbon.widget.ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_google" />

        <carbon.widget.TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/leaguespartan_variablefont_wght"
            android:text="Sign in with Google"
            android:textColor="@color/background"
            android:textSize="24sp"
            android:textStyle="bold" />

    </carbon.widget.RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>