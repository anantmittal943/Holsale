<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activity.MainActivity">

    <carbon.widget.RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:background="@color/colorPrimaryVariant"
        android:elevation="2dp"
        app:carbon_cornerRadiusBottomEnd="24dp"
        app:carbon_cornerRadiusBottomStart="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <carbon.widget.TextView
            android:id="@+id/nameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:fontFamily="@font/overlockregular"
            android:text="Hi, Name"
            android:textColor="@color/background"
            android:textSize="32sp"
            android:textStyle="bold" />

        <carbon.widget.EditText
            android:id="@+id/searchBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:background="@color/colorPrimaryVariant"
            android:elevation="3dp"
            android:fontFamily="@font/leaguespartan_variablefont_wght"
            android:hint="Enter phone number"
            android:imeOptions="actionSearch"
            android:inputType="phone"
            android:maxLength="10"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="@color/background"
            android:textColorHint="@color/background"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:carbon_cornerRadius="10dp"
            app:carbon_stroke="@color/colorSecondary"
            app:carbon_strokeWidth="2dp" />

        <carbon.widget.ImageView
            android:id="@+id/searchBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:contentDescription="search by phone number"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            app:carbon_cornerRadius="42dp"
            app:carbon_rippleColor="@color/colorSecondaryVariant"
            app:carbon_rippleStyle="over"
            app:carbon_tint="@color/background" />

    </carbon.widget.RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listRV"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:listitem="@layout/main_item_layout" />

    <carbon.widget.ImageView
        android:id="@+id/noDataImg"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:src="@drawable/no_data"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/addListBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <carbon.widget.TextView
        android:id="@+id/startAddingTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="Start by adding a new list!!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/noDataImg"
        app:layout_constraintStart_toStartOf="@id/noDataImg"
        app:layout_constraintTop_toBottomOf="@id/noDataImg" />

    <carbon.widget.ImageView
        android:id="@+id/addListBtn"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_margin="20dp"
        android:background="@color/colorSecondary"
        android:clickable="true"
        android:contentDescription="add a new list"
        android:elevation="8dp"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_plus"
        app:carbon_cornerRadius="16dp"
        app:carbon_rippleColor="@color/colorPrimaryVariant"
        app:carbon_rippleHotspot="true"
        app:carbon_rippleRadius="50dp"
        app:carbon_rippleStyle="background"
        app:carbon_tint="@color/carbon_black_87"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>