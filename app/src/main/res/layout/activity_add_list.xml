<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@color/background"
    tools:context=".activity.AddListActivity">

    <carbon.widget.ImageView
        android:id="@+id/truck"
        android:layout_width="match_parent"
        android:layout_marginTop="5dp"
        android:layout_height="100dp"
        android:src="@drawable/truck"
        app:carbon_tint="@color/colorPrimaryVariant"
        app:layout_constraintTop_toBottomOf="@id/topTxt" />

    <carbon.widget.ImageView
        android:id="@+id/backBtn"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@color/colorPrimaryVariant"
        android:elevation="1dp"
        android:padding="8dp"
        android:src="@drawable/ic_left"
        android:clickable="true"
        android:focusable="true"
        app:carbon_cornerRadius="16dp"
        app:carbon_rippleColor="@color/colorSecondary"
        app:carbon_rippleStyle="background"
        app:carbon_tint="@color/background"
        app:layout_constraintBottom_toBottomOf="@id/topTxt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topTxt" />

    <carbon.widget.TextView
        android:id="@+id/topTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryVariant"
        android:fontFamily="@font/overlockregular"
        android:padding="16dp"
        android:text="Order from Photo"
        android:textAlignment="center"
        android:textColor="@color/background"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <carbon.widget.TextView
        android:id="@+id/suggestionTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="Take  a photo of your list or upload an existing list one. We'll process it and get back to you with a quote."
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/truck" />

    <carbon.widget.ImageView
        android:id="@+id/editBtn"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="10dp"
        android:background="@color/background"
        android:clickable="true"
        android:contentDescription="edit button"
        android:elevation="2dp"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_edit"
        android:visibility="gone"
        app:carbon_cornerRadius="16dp"
        app:carbon_rippleColor="@color/colorSecondary"
        app:carbon_rippleStyle="background"
        app:carbon_tint="@color/colorPrimaryVariant"
        app:layout_constraintEnd_toStartOf="@id/deleteBtn"
        app:layout_constraintStart_toStartOf="@id/uploadCard"
        app:layout_constraintTop_toBottomOf="@id/suggestionTxt" />

    <carbon.widget.ImageView
        android:id="@+id/deleteBtn"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="50dp"
        android:background="@color/background"
        android:clickable="true"
        android:contentDescription="delete button"
        android:elevation="2dp"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_delete"
        android:visibility="gone"
        app:carbon_cornerRadius="16dp"
        app:carbon_rippleColor="@color/colorSecondary"
        app:carbon_rippleStyle="background"
        app:carbon_tint="@color/colorPrimaryVariant"
        app:layout_constraintEnd_toEndOf="@id/uploadCard"
        app:layout_constraintStart_toEndOf="@id/editBtn"
        app:layout_constraintTop_toTopOf="@id/editBtn" />

    <carbon.widget.RelativeLayout
        android:id="@+id/uploadCard"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/stroke"
        android:clickable="true"
        android:contentDescription="upload image"
        android:focusable="true"
        android:src="@drawable/upload"
        app:carbon_cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editBtn">

        <carbon.widget.ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_image_not_found"
            android:visibility="gone" />

        <carbon.widget.TextView
            android:id="@+id/uploadSuggestionTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="80dp"
            android:fontFamily="@font/leaguespartan_variablefont_wght"
            android:text="Tap to upload photo of your order list"
            android:textSize="16sp"
            android:textStyle="bold" />

        <carbon.widget.Button
            android:id="@+id/uploadBtn"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/uploadSuggestionTxt"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:background="@color/colorSecondaryVariant"
            android:fontFamily="@font/overlockregular"
            android:padding="8dp"
            android:text="Upload Photo"
            android:textSize="16sp"
            android:textStyle="bold"
            app:carbon_cornerRadius="16dp"
            app:carbon_rippleColor="@color/colorPrimaryVariant"
            app:carbon_rippleStyle="background" />

    </carbon.widget.RelativeLayout>

    <carbon.widget.TextView
        android:id="@+id/addPhoneNoTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="Add Phone Number"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@id/uploadCard"
        app:layout_constraintTop_toBottomOf="@id/uploadCard" />

    <carbon.widget.LinearLayout
        android:id="@+id/phoneNoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:animateLayoutChanges="true"
        android:background="@color/backgroundLight"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        app:carbon_cornerRadius="16dp"
        app:carbon_stroke="@color/carbon_blueGrey_200"
        app:carbon_strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="@id/addPhoneNoTxt"
        app:layout_constraintTop_toBottomOf="@id/addPhoneNoTxt">

        <carbon.widget.ImageView
            android:id="@+id/callIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_phone"
            app:carbon_cornerRadius="8dp"
            app:carbon_tint="@color/colorPrimaryVariant" />

        <carbon.widget.EditText
            android:id="@+id/addPhoneNoEdTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/callIcon"
            android:layout_weight="1"
            android:background="@color/backgroundLight"
            android:fontFamily="@font/leaguespartan_variablefont_wght"
            android:hint="+91 000 000 0000"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="8dp"
            android:textColor="@color/colorPrimaryVariant"
            android:textColorHint="@color/colorSecondary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:carbon_cornerRadius="16dp"
            app:carbon_rippleColor="@color/background"
            app:carbon_rippleStyle="background" />

    </carbon.widget.LinearLayout>

    <carbon.widget.TextView
        android:id="@+id/addAddressTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="Add Address"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="@id/addPhoneNoTxt"
        app:layout_constraintTop_toBottomOf="@id/phoneNoCard" />

    <carbon.widget.LinearLayout
        android:id="@+id/addressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:animateLayoutChanges="true"
        android:background="@color/backgroundLight"
        android:gravity="center_vertical"
        android:padding="4dp"
        app:carbon_cornerRadius="16dp"
        app:carbon_stroke="@color/carbon_blueGrey_200"
        app:carbon_strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="@id/addAddressTxt"
        app:layout_constraintTop_toBottomOf="@id/addAddressTxt">

        <carbon.widget.ImageView
            android:id="@+id/locationIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_location"
            app:carbon_cornerRadius="8dp"
            app:carbon_tint="@color/colorPrimaryVariant" />

        <carbon.widget.EditText
            android:id="@+id/addAddressEdTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/locationIcon"
            android:layout_weight="1"
            android:background="@color/backgroundLight"
            android:fontFamily="@font/leaguespartan_variablefont_wght"
            android:hint="Search for address"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="8dp"
            android:textColor="@color/colorPrimaryVariant"
            android:textColorHint="@color/colorSecondary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:carbon_cornerRadius="14dp"
            app:carbon_rippleColor="@color/background"
            app:carbon_rippleStyle="background" />

    </carbon.widget.LinearLayout>

    <carbon.widget.TextView
        android:id="@+id/createdAtTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="Created At"
        android:textAlignment="viewStart"
        android:textColor="@color/colorPrimaryVariant"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addressCard" />

    <carbon.widget.TextView
        android:id="@+id/updatedAtTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="28dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="Updated At"
        android:textAlignment="viewEnd"
        android:textColor="@color/colorPrimaryVariant"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addressCard" />

    <carbon.widget.TextView
        android:id="@+id/createdDateTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="date"
        android:textColor="@color/carbon_blueGrey_700"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/createdAtTxt"
        app:layout_constraintStart_toStartOf="@id/createdAtTxt"
        app:layout_constraintTop_toBottomOf="@id/createdAtTxt" />

    <carbon.widget.TextView
        android:id="@+id/createdTimeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="time"
        android:textColor="@color/carbon_blueGrey_700"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/createdAtTxt"
        app:layout_constraintStart_toStartOf="@id/createdAtTxt"
        app:layout_constraintTop_toBottomOf="@id/createdDateTxt" />

    <carbon.widget.TextView
        android:id="@+id/updatedDateTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="date"
        android:textColor="@color/carbon_blueGrey_700"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/updatedAtTxt"
        app:layout_constraintStart_toStartOf="@id/updatedAtTxt"
        app:layout_constraintTop_toBottomOf="@id/updatedAtTxt" />

    <carbon.widget.TextView
        android:id="@+id/updatedTimeTxt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="time"
        android:textColor="@color/carbon_blueGrey_700"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/updatedAtTxt"
        app:layout_constraintStart_toStartOf="@id/updatedAtTxt"
        app:layout_constraintTop_toBottomOf="@id/updatedDateTxt" />

    <carbon.widget.Button
        android:id="@+id/negativeBtn"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/background"
        android:elevation="4dp"
        android:fontFamily="@font/overlockregular"
        android:text="Cancel"
        android:textColor="@color/colorPrimaryVariant"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:carbon_cornerRadius="16dp"
        app:carbon_rippleColor="@color/colorSecondary"
        app:carbon_rippleStyle="background"
        app:carbon_stroke="@color/colorSecondaryVariant"
        app:carbon_strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/positiveBtn"
        app:layout_constraintStart_toStartOf="parent" />

    <carbon.widget.Button
        android:id="@+id/positiveBtn"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/colorPrimaryVariant"
        android:elevation="4dp"
        android:fontFamily="@font/overlockregular"
        android:text="Add"
        android:textColor="@color/background"
        android:textSize="14sp"
        android:textStyle="bold"
        app:carbon_cornerRadius="16dp"
        app:carbon_rippleColor="@color/colorSecondary"
        app:carbon_rippleStyle="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/negativeBtn" />


</androidx.constraintlayout.widget.ConstraintLayout>