<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:animateLayoutChanges="true"
    android:background="@color/white"
    app:carbon_cornerRadius="16dp"
    app:carbon_elevation="6dp"
    app:carbon_rippleColor="@color/colorSecondary"
    app:carbon_rippleStyle="background">

    <carbon.widget.FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:background="@color/colorSecondaryVariant"
        app:carbon_cornerRadius="12dp"
        app:carbon_elevation="2dp">

        <carbon.widget.ImageView
            android:id="@+id/previewImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_image_not_found"
            app:carbon_cornerRadius="12dp" />

    </carbon.widget.FrameLayout>

    <carbon.widget.LinearLayout
        android:id="@+id/numberSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imageContainer"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <carbon.widget.ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_phone"
            app:carbon_tint="@color/colorPrimaryVariant" />

        <carbon.widget.TextView
            android:id="@+id/phoneNoPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/overlockregular"
            android:maxLines="2"
            android:text="+91 000 000 0000"
            android:textColor="@color/colorPrimaryVariant"
            android:textSize="16sp" />

    </carbon.widget.LinearLayout>

    <carbon.widget.LinearLayout
        android:id="@+id/addressSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/numberSection"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <carbon.widget.ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_location"
            app:carbon_tint="@color/colorPrimaryVariant" />

        <carbon.widget.TextView
            android:id="@+id/addressPreview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/overlockregular"
            android:text="Address"
            android:textColor="@color/colorPrimaryVariant"
            android:textSize="16sp" />

    </carbon.widget.LinearLayout>

    <carbon.widget.LinearLayout
        android:id="@+id/dateTimeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/addressSection"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <!-- Date Section -->
        <carbon.widget.LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <carbon.widget.ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_calendar"
                app:carbon_tint="@color/black" />

            <carbon.widget.TextView
                android:id="@+id/datePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/overlockregular"
                android:text="Date"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="Dec 15, 2024" />

        </carbon.widget.LinearLayout>

        <!-- Time Section -->
        <carbon.widget.LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <carbon.widget.ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_clock"
                app:carbon_tint="@color/black" />

            <carbon.widget.TextView
                android:id="@+id/timePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/overlockregular"
                android:text="Time"
                android:textColor="@color/black"
                android:textSize="14sp"
                tools:text="2:30 PM" />

        </carbon.widget.LinearLayout>

    </carbon.widget.LinearLayout>

</carbon.widget.RelativeLayout>