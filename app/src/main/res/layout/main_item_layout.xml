<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:animateLayoutChanges="true"
    android:background="@color/background"
    android:elevation="2dp"
    app:carbon_cornerRadius="24dp"
    app:carbon_rippleColor="@color/colorSecondary"
    app:carbon_rippleStyle="background"
    app:carbon_stroke="@color/colorSecondaryVariant"
    app:carbon_strokeWidth="3dp">

    <carbon.widget.TextView
        android:id="@+id/phoneNoPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="8dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:text="phone number"
        android:textColor="@color/colorPrimary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <carbon.widget.ImageView
        android:id="@+id/previewImg"
        android:layout_width="250dp"
        android:layout_height="180dp"
        android:layout_below="@id/phoneNoPreview"
        android:layout_centerHorizontal="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_image_not_found"
        app:carbon_cornerRadius="14dp"
        app:carbon_stroke="@color/colorSecondary"
        app:carbon_strokeWidth="2dp" />

    <carbon.widget.TextView
        android:id="@+id/addressPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/previewImg"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="address"
        android:textColor="@color/colorPrimaryVariant"
        android:textSize="22sp"
        android:textStyle="bold" />

    <carbon.widget.TextView
        android:id="@+id/datePreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/addressPreview"
        android:layout_alignParentStart="true"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="date"
        android:textColor="@color/carbon_blueGrey_700"
        android:textSize="16sp"
        android:textStyle="bold" />

    <carbon.widget.TextView
        android:id="@+id/timePreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/addressPreview"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:maxLines="1"
        android:text="time"
        android:textColor="@color/carbon_blueGrey_700"
        android:textSize="16sp"
        android:textStyle="bold" />

</carbon.widget.RelativeLayout>