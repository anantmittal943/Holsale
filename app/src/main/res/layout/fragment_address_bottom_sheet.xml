<?xml version="1.0" encoding="utf-8"?>
<carbon.widget.RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <carbon.widget.EditText
        android:id="@+id/addressEdTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@color/backgroundLight"
        android:fontFamily="@font/leaguespartan_variablefont_wght"
        android:hint="Where ?"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:textStyle="bold"
        android:visibility="visible"
        android:textSize="18sp"
        android:padding="14dp"
        app:carbon_strokeWidth="1dp"
        app:carbon_stroke="@color/black"
        app:carbon_cornerRadius="16dp" />

    <!--<com.google.android.libraries.places.widget.AutocompleteSupportFragment
        android:id="@+id/autocomplete_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>-->

</carbon.widget.RelativeLayout>